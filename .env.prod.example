# Copy this file to .env.prod and fill real values.
# Never commit .env.prod with real secrets.

APP_DOMAIN=koom.com.kg
APP_ENV=production
PORT=8080

POSTGRES_DB=koom
POSTGRES_USER=koom
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgres://koom:replace_with_strong_database_password@postgres:5432/koom?sslmode=disable

JWT_SECRET=replace_with_at_least_32_random_characters_prefer_64_plus
ACCESS_TOKEN_TTL_MINUTES=5
ALLOWED_ORIGINS=https://koom.com.kg
BCRYPT_COST=12

# The API refuses to start in production unless SMS is configured.
SMS_PROVIDER=smspro
SMSPRO_LOGIN=replace_with_smspro_login
SMSPRO_PASSWORD=replace_with_smspro_password
# Must be approved in the SMSPro account; 1-11 ASCII letters/digits/dot/dash or 14 digits.
SMSPRO_SENDER=KOOM

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Platform roles. The project owner is always super_admin.
PROJECT_OWNER_PHONE=
SUPER_ADMIN_PHONES=
PLATFORM_ADMIN_PHONES=

BACKUP_RETENTION_DAYS=14
BACKUP_PREFIX=mobilechat
# Required for the backup service health check to pass in production.
BACKUP_S3_URI=s3://replace-with-backup-bucket/koom
AWS_REGION=eu-north-1
# Prefer the server's instance role. If static credentials are necessary, inject
# them through a secret manager and never commit their values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RUN_MIGRATIONS_ON_START=false
REALTIME_BROKER=local
BACKEND_INSTANCE_COUNT=1

# Match the private Docker subnet used by the reverse proxy when it contacts the API.
TRUSTED_PROXY_CIDRS=172.18.0.0/16

# Test login is forbidden in staging and production. Keep disabled here.
TEST_AUTH_ENABLED=false
TEST_AUTH_PHONE=
TEST_AUTH_CODE=
TEST_AUTH_DISPLAY_NAME=Firebase Test User

# Content moderation / AI filters
CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_PROVIDER=huggingface
HF_TOKEN=
HF_MODERATION_MODEL=unitary/multilingual-toxic-xlm-roberta
HF_MODERATION_ENDPOINT=https://router.huggingface.co/hf-inference/models
HF_MODERATION_THRESHOLD=0.72
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_ENDPOINT=https://api.openai.com/v1/moderations
MODERATION_FAIL_CLOSED=true
