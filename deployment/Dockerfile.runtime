FROM alpine:3.24

ARG BUILD_SHA
LABEL org.opencontainers.image.revision="${BUILD_SHA}"

RUN adduser -D -H -u 10001 appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app/data
WORKDIR /app
COPY --chown=10001:10001 koom-server /app/koom-server
COPY --chown=10001:10001 koom-migrate /app/koom-migrate
COPY --chown=10001:10001 migrations /app/migrations
USER appuser

ENV PORT=8080
EXPOSE 8080

ENTRYPOINT ["/app/koom-server"]
